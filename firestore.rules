rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles: Users can read/write their own profile, everyone can read limited fields
    match /users/{userId} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Admissions & Scholarships: Public can read, Admins can write
    match /admissions/{admissionId} {
      allow read;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    match /scholarships/{scholarshipId} {
      allow read;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Forum: Public can read, authenticated users can write
    match /discussions/{postId} {
      allow read;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.authorId || request.auth.token.role == 'admin');

      match /replies/{replyId} {
        allow read;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && (request.auth.uid == resource.data.authorId || request.auth.token.role == 'admin');
      }
    }

    // Mentor Applications: Only mentors can read/write their own applications, Admin can read/write all
    match /mentor_applications/{appId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.role == 'admin');
    }
  }
}
